FINODE_DATABASE_URL=<DATABASE-URL>
FINODE_DATABASE_ECHO=<true|false>
FINODE_SUPABASE_URL=<SUPABASE-PROJECT-URL>
FINODE_SUPABASE_AUDIENCE=authenticated
FINODE_SUPABASE_ANON_KEY=<SUPABASE-ANON-KEY>
FINODE_COOKIE_SECURE=<true|false>
FINODE_MAX_ACCOUNT_DEPTH=20
FINODE_MCP_RATE_LIMIT=120
# Minutes between background runs that record due recurring transactions (0 = off)
FINODE_RECURRING_INTERVAL_MINUTES=15

# Invite-only sign-up (optional; leave commented to keep /signup closed).
# Generate the code with: openssl rand -base64 24
# FINODE_SIGNUP_CODE=<INVITE-CODE-AT-LEAST-16-CHARACTERS>
# FINODE_SUPABASE_SERVICE_ROLE_KEY=<SUPABASE-SECRET-OR-SERVICE-ROLE-KEY>
# Most people with an account in total, you included; sign-up closes when it is reached (0 = no limit).
# FINODE_MAX_USERS=10
# A test with invited people: the notice they accept at sign-up and can reread under Profile, and the address
# "Send feedback" writes to (the link is hidden when it is empty).
# FINODE_TEST_NOTICE=true
# FINODE_FEEDBACK_EMAIL=<YOUR-EMAIL>

# What one person may hold (0 = no limit) and how fast sign-in and sign-up attempts may come; defaults shown.
# FINODE_MAX_ACCOUNTS=500
# FINODE_MAX_TRANSACTIONS=100000
# FINODE_MAX_TRANSACTIONS_PER_DAY=1000
# FINODE_MAX_POSTINGS_PER_TRANSACTION=100
# FINODE_MAX_RESTORE_MB=25
# FINODE_LOGIN_ATTEMPTS=10
# FINODE_SIGNUP_ATTEMPTS=5
# FINODE_ATTEMPT_WINDOW_MINUTES=15
# FINODE_TIMEZONE=Asia/Kolkata
# FINODE_API_DOCS=false
# FINODE_PASSWORD_RESET=false
# FINODE_RESET_ATTEMPTS=5

# docker compose only (ignored by the app)
APP_DOMAIN=<PUBLIC-HOST-NAME>
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=le
WEB_CONCURRENCY=2
# BACKUP_UID=1000
# BACKUP_GID=1000
# BACKUP_PATH=./backups
# BACKUP_KEEP_DAYS=14
# BACKUP_HOUR=2
